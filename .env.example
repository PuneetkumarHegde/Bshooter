# ============================================================
#  BSHOOTER — ROOT ENVIRONMENT EXAMPLE
#  Copy the relevant blocks into client/.env and server/.env
#  Never commit real secrets. This file documents required keys only.
# ============================================================

# ---------- FRONTEND (client/.env) ----------
# The single source of truth for the game name on the frontend.
# Changing this value and rebuilding renames the game EVERYWHERE.
VITE_GAME_NAME=BUBBLE BLAST ADVENTURE
VITE_API_URL=http://localhost:5000/api

# ---------- BACKEND (server/.env) ----------
# The single source of truth for the game name on the backend.
GAME_NAME=BUBBLE BLAST ADVENTURE
PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=

# JWT signing secret — use a long random string in production
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# Optional: default admin bootstrap (used by seed script)
ADMIN_EMAIL=admin@bshooter.dev
ADMIN_PASSWORD=
