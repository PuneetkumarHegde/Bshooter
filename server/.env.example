# Backend environment — copy to server/.env and fill in.
# GAME_NAME is the single source of truth for the game name on the backend.
GAME_NAME=BUBBLE BLAST ADVENTURE

PORT=5000
NODE_ENV=development

# MongoDB Atlas (or local) connection string.
# If left empty the API still starts, but DB-backed routes return 503.
MONGODB_URI=

# Auth — use a long, random secret in production. NEVER commit the real value.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s) for CORS (comma-separated).
CLIENT_ORIGIN=http://localhost:5173

# Seed script bootstrap admin (optional).
ADMIN_EMAIL=admin@bshooter.dev
ADMIN_PASSWORD=
